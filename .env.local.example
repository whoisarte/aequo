# Application Mode - Controls which implementations are used
# Options: 'local' | 'development' | 'production'
#
# - local: All services mocked (no external dependencies). Auto-logs in as mock-user-1.
#          Use for: local development without any external accounts.
#
# - development: Real Supabase auth/DB, but mock Stripe/Gemini.
#                Use for: testing with real database on dev Supabase project.
#
# - production: All real services (Supabase, Stripe, Gemini).
#               Requires all credentials to be provided.
#               Use for: staging (dev.aequo.app) and production (aequo.app).
NEXT_PUBLIC_APP_MODE=local

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
